class Solution:
    def partitionLabels(self, s: str) -> list[int]:
        last = {c: i for i, c in enumerate(s)}   # 每个字母最后出现的位置
        res = []
        start = end = 0#end用来记录片段的最右端，start记录片段的最左端

        for i, c in enumerate(s):
            end = max(end, last[c])              # 撑大当前片段的右边界
            if i == end:                         # 走到边界 → 可以切了
                res.append(i - start + 1)
                start = i + 1

        return res
#最开始的想法是用一个栈来保存切割出来的片段，然后遍历后续字母如果字母在之前出现过就弹出栈中的片段直到栈没有相同字母的片段将弹出的片段拼接起来重新入栈，直到遍历整个数组，站中的内容就是需要的片段
#对于边界条件的拼接和利用哈希表查找复杂度仍最小为O(n),记录每个字母最后出现的位置，遍历字符串，如果到最后出现的位置证明片段可划分
