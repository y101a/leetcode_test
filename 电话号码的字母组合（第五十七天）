class Solution:
    def letterCombinations(self, digits: str) -> list[str]:
        phone={
        '2':'abc',
        '3':'def',
        '4':'ghi',
        '5':'jkl',
        '6':'mno',
        '7':'pqrs',
        '8':'tuv',
        '9':'wxyz'}
        ans=[]
        def dfs(res):
            if len(res)==len(digits):
                ans.append("".join(res))#这里不直接保存快照是因为保存快照后还需要额外转成字符串，直接转成字符串加入更方便
                return
            for i in phone[digits[len(res)]]:
                res.append(i)
                dfs(res)
                res.pop()
        dfs([])
        return ans
#这道题的思路与之前的题目没有太大不同，依旧是递归内加循环，但是整体实现起来比钱两道题要简单
