import random
class Solution:
    def findKthLargest(self, nums: List[int], k: int) -> int:
        a=nums
        target=len(a)-k
        lo,hi=0,len(a)-1
        while True:
            r=random.randint(lo,hi)
            a[lo],a[r]=a[r],a[lo]
            pivot=a[lo]
            lt,i,gt=lo,lo,hi
            while i<=gt:
                if a[i]<pivot:
                    a[lt],a[i]=a[i],a[lt]
                    lt+=1
                    i+=1
                elif a[i]>pivot:
                    a[gt],a[i]=a[i],a[gt]
                    gt-=1
                else:
                    i+=1
            if lt<=target<=gt:
                return pivot
            elif  target<lt:
                hi=lt-1
            else:
                lo=gt+1
