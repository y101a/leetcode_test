class Solution:
    def numSquares(self, n: int) -> int:
        dp=[float('inf')]*(n+1)
        dp[0]=0
        for i in range(1,n+1):
            j=1
            while j*j<=i:
                dp[i]=min(dp[i],dp[i-j*j]+1)#核心从dp[0]开始推理出前n个dp的所有值
                j+=1
        return dp[n]
#对于这道动态规划用到了dp来记录n之前的所有最少完全平方数，进而计算n的完全平方数，可以减少重复元素的计算
#难点在于读取的同时更新dp数组，这道题不能只考虑完全平方数而不考虑其他元素，因为只考虑完全平方数会涉及过多分支，时间复杂度并不能减少
