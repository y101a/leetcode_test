class Solution:
    def isValid(self, s: str) -> bool:
        stack=[]
        pairs={')':'(',']':'[','}':'{'}#注意要定义配对列表来进行括号匹配
        for i in s:
            if i in "([{":#这里不需要分开写三种可以合在一起
                stack.append(i)
            else:
                if not stack or stack.pop() !=pairs[i]:
                    return False
        return not stack#最后不能直接返回true，因为站内可能存在未配对的左括号，因此返回not stack
#一道很经典的入栈问题，思路就是遇到左括号就入栈，遇到右括号就弹出，并检查是否匹配，最后检查站内是否还有剩余
