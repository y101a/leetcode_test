class Solution:
    def climbStairs(self, n: int) -> int:
        if n<=2:
            return n
        f=[0]*(n+1)#n+1数组长度将f[0]位置空出即可
        f[1]=1
        f[2]=2
        for i in range(3,n+1):#range规则左闭右开因此要到n阶楼梯右边需要写n+1
            f[i]=f[i-1]+f[i-2]
        return f[n]
#这道题的思路是要从最后一个阶梯开始计算，最后一个阶梯只有两种情况一种是一步一种是二步，在计算前一个阶梯以此类推
#说实话这道题并不太像动态规划，优化dp[]，只用两个滚动变量就能计算所有可能
