class Solution {
    public int[] productExceptSelf(int[] nums) {
        int len=nums.length;
        int[] res=new int[len];
        res[0]=1;
        int temp=1;
        for(int i=1;i<len;i++){
            res[i]=res[i-1]*nums[i-1];
        }//计算上半区
        for(int i=len-2;i>=0;i--){
            temp*=nums[i+1];//数组最后一个数不用变因为在上一个循环中只有这个数是正确的
            res[i]*=temp;
        }
        return res;
    }
}
