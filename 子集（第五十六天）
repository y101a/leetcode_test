class Solution:
    def subsets(self, nums: list[int]) -> list[list[int]]:
        res=[]
        n=len(nums)
        for i in range(n+1):
            def dfs(start,cur):
                if len(cur)==i:
                    res.append(cur[:])
                    return
                for j in range(start,n):
                    cur.append(nums[j])
                    dfs(j+1,cur)
                    cur.pop()
            dfs(0,[])
        return res
#我的想法是按照元素个数分类返回第一次返回0个元素的所有可能，第二次返回1个元素的...
#实现过程出乎意料，要在递归函数外面套一层循环来表示本次返回几个元素，在递归过程中还要列举所有可能，我自己的代码循环与递归的功能完全反了导致写不出来

class Solution:
    def subsets(self, nums: list[int]) -> list[list[int]]:
        res = []

        def dfs(start, cur):
            res.append(cur[:])
            for i in range(start, len(nums)):
                cur.append(nums[i])
                dfs(i + 1, cur)
                cur.pop()

        dfs(0, [])
        res.sort(key=len)       # 按元素个数分组
        return res
#另一种思路是进行到底然后在弹出替换其他元素，相比上一种做法简单很多
