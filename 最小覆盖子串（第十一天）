class Solution {
    Map<Character,Integer> tmap=new HashMap<>();
    Map<Character,Integer> smap=new HashMap<>();
    public String minWindow(String s, String t) {
        int tlen=t.length();
        for(int i=0;i<tlen;i++){
            char c=t.charAt(i);
            tmap.put(t.charAt(i),tmap.getOrDefault(c,0)+1);
        }
        int l=0,r=-1;
        int len=Integer.MAX_VALUE,ansL=-1,ansR=-1;
        int slen=s.length();
        while(r<slen){
            ++r;
            if(r<slen&&tmap.containsKey(s.charAt(r))){
                smap.put(s.charAt(r),smap.getOrDefault(s.charAt(r),0)+1);
            }//右边界不断右移直到窗口中完全包含t
            while(check()&&l<=r){
                if(r-l+1<len){
                    len=r-l+1;
                    ansL=l;
                    ansR=l+len;
                }//窗口长度r-l+1
                if(tmap.containsKey(s.charAt(l))){
                    smap.put(s.charAt(l),smap.getOrDefault(s.charAt(l),0)-1);
                }
                ++l;
            }//左边界开始收缩，直到窗口最小
        }
        return ansL==-1?"":s.substring(ansL,ansR);//ansL如果是-1说明窗口根本没动，则返回空
    }
    public boolean check(){
        Iterator iter=tmap.entrySet().iterator();//创建tmap迭代器，用来逐个取出里面的键值对
        while(iter.hasNext()){//遍历所有字符
            Map.Entry entry=(Map.Entry) iter.next();//取出一个键值对
            Character key=(Character) entry.getKey();//分理出key
            Integer val=(Integer) entry.getValue();//分离出value
            if(smap.getOrDefault(key,0)<val){
                return false;
            }//如果窗口内的key小于需要值返回false
        }
        return true;
    }
}
