class Solution {
    public static String minWindow(String s, String t) {
        if (s == null || t == null || s.length() < t.length()) {
            return "";
        }
        
        int[] need = new int[128];    // 记录t中每个字符的需求数量，数组大小128因为t大小写都有可能
        int[] window = new int[128];  // 记录当前窗口中每个字符的数量
        for (char c : t.toCharArray()) {
            need[c]++;
        }
        
        int needCount = 0; // t中不同字符的种类数
        for (int num : need) {
            if (num > 0) {
                needCount++;
            }
        }
        
        int left = 0, right = 0;
        int count = 0; // 当前窗口中已满足需求的字符种类数
        int minLen = Integer.MAX_VALUE;
        int minLeft = 0;
        
        while (right < s.length()) {
            char c = s.charAt(right);
            window[c]++;
            // 若某字符恰好满足需求，则已满足种类数+1
            if (need[c] > 0 && window[c] == need[c]) {
                count++;
            }
            
            // 窗口已覆盖t，开始收缩左边界
            while (count == needCount) {
                if (right - left + 1 < minLen) {
                    minLen = right - left + 1;
                    minLeft = left;
                }
                char d = s.charAt(left);
                // 移除左边界字符后，若该字符不再满足需求，则已满足种类数-1
                if (need[d] > 0 && window[d] == need[d]) {
                    count--;
                }
                window[d]--;
                left++;
            }
            right++;
        }
        
        return minLen == Integer.MAX_VALUE ? "" : s.substring(minLeft, minLeft + minLen);
    }
}
