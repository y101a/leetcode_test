class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashSet<Character> set=new HashSet<>();//作为单独的字母不能使用String，应该使用Character
        int left=0,right=0;
        int max=0;
        while(right<s.length()){
            if(!set.contains(s.charAt(right))){
                set.add(s.charAt(right));//String类型不能写s[right]
                right++;
                max=Math.max(max,right-left);
            }
            else{
                set.remove(s.charAt(left));//因为是最长子串，所以左指针移动时要移除set中的元素
                left++;
            }
        }
        return max;
    }
}
//滑动窗口用双指针作为边界判断

class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n = s.length();
        int ans = 0;

        int[] last = new int[128];
        for(int i = 0; i < 128; i++){
            last[i] = -1;
        }
        for(int left = 0, right = 0; right < n; right ++){
            char c = s.charAt(right);
            left = Math.max(left, last[c] + 1);

            last [c] = right;

            ans = Math.max(ans, right - left + 1);
        }
        return ans;
    }
}
