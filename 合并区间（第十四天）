class Solution {
    public int[][] merge(int[][] intervals) {
        List<int[]> res=new ArrayList<>();//不确定数字长度时这样写就可以
        Arrays.sort(intervals,(a,b)->a[0]-b[0]);//二重数组排序不能使用默认方法
        int left=intervals[0][0],right=intervals[0][1];
        for (int i = 1; i < intervals.length; i++) {
            if (intervals[i][0] <= right) {
                right = Math.max(right, intervals[i][1]);  // 重叠，取较大的右端点
            } else {
                res.add(new int[]{left, right});  // 不重叠，存入结果
                left = intervals[i][0];
                right = intervals[i][1];
            }
        }
        res.add(new int[]{left,right});//最后一次加入需要单独写
        return res.toArray(new int[res.size()][]);
    }
}
