class Solution {
    public int maxSubArray(int[] nums) {
        int len=nums.length+1;
        int[] frontadd=new int[len];
        frontadd[0]=0;//前缀和数组第一个值是0,比原数组空间大一
        for(int i=0;i<len-1;i++){
            frontadd[i+1]=frontadd[i]+nums[i];
        }
        int max=Integer.MIN_VALUE,min=0;
        for(int j=1;j<len;j++){
            max=Math.max(max,frontadd[j]-min);
            min=Math.min(min,frontadd[j]);
        }//这里直接比较大小就能找到前缀和数组中最大值与最小值的差
        return max;//在for循环中已经frontadd[j]-min,所以不需要再-min了直接返回max
    }
}
