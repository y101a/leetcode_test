class Solution {
    public int maxSubArray(int[] nums) {
        int resultMax = nums[0];
        int curMax = 0;
        for(int i = 0; i<nums.length;i++){
            if(curMax<0){
                curMax = 0;
            }
            curMax = curMax+nums[i];
            resultMax = Math.max(curMax,resultMax);
            
        }
        return resultMax;
    }
}
