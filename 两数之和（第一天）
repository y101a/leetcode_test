class Solution {
    public int[] twoSum(int[] nums, int target) {
        int a=0;
        for(int num:nums){
            int b=target-num;
            for(int i=a+1;i<nums.length;i++){
                if(nums[i]==b){
                    int c=i;
                    return new int[]{a,c};
                }
            }
           a++; 
        }
        return new int[]{};
    }
}//第一次暴力解题竟然还通过了？
