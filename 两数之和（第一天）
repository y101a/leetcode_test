class Solution {
    public int[] twoSum(int[] nums, int target) {
        int a=0;
        for(int num:nums){
            int b=target-num;
            for(int i=a+1;i<nums.length;i++){
                if(nums[i]==b){
                    int c=i;
                    return new int[]{a,c};
                }
            }
           a++; 
        }
        return new int[]{};
    }
}//第一次暴力解题竟然还通过了？

class Solution {
    public int[] twoSum(int[] nums, int target) {
        Map<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            map.put(nums[i],i);
        }
        for(int j=0;j<nums.length;j++){
            int a=target-nums[j];
            if(map.containsKey(a)&&map.get(a)!=j){
                return new int[]{map.get(a),j};
            }//注意&&map.get(a)!=j，否则会重复成[3,3]->[1,1]
        
        }
        return new int[]{};
    }
}//自己写的哈希、

class Solution {
    public int[] twoSum(int[] nums, int target) {
        Map<Integer, Integer> map = new HashMap<>();
        for (int i = 0; i < nums.length; i++) {
            int first = nums[i];
            int second = target - first;
            if (!map.containsKey(second)){
                map.put(first,i);
                continue;
            }
            return new int[]{i,map.get(second)};
        }
        return new int[0];
    }
}//标准答案
