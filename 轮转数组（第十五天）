class Solution {
    public void rotate(int[] nums, int k) {
        int len=nums.length;
        k=k%len;
        int[] arr=new int[len];
        for(int i=0;i<len;i++){
            arr[(i+k)%len]=nums[i];//i+k找到要替换的数组下标，%len保证数组不会越界
        }
       for(int j=0;j<len;j++){
        nums[j]=arr[j];
       }
    }
}
//这道题的思路很好想，关键问题是如何把空间节省到O(1)程度

class Solution {
    public void rotate(int[] nums, int k) {
        k %= nums.length;
        helper(nums, 0, nums.length - 1);
        helper(nums, 0, k - 1);
        helper(nums, k, nums.length - 1);
    }

    private void helper(int[] nums, int left, int right) {
        while (left < right) {
            int t = nums[left];
            nums[left] = nums[right];
            nums[right] = t;
            left++;
            right--;
        }
    }
}
