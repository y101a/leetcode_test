class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int m=matrix.length;
        int n=matrix[0].length;
        int i=0,j=n-1;
        while(i<m&&j>=0){//如果只有一个元素需要j=0
            if(matrix[i][j]==target){
                return true;
            }
            else if(matrix[i][j]>target){
                j--;
            }
            else{
                i++;
            }
        }
        return false;
    }
}
//思路很好理解，但是关键是从左下角或者右上角开始寻找，如果从最初位置开始可能会找不到数字
